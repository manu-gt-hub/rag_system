{
  // Build-time code (runs on Node): indexer, evaluation, scripts and tests
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/**/*.ts", "indexer/**/*.ts", "evaluation/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "exclude": ["test/ui-dom.test.ts"]
}
