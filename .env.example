# =============================================================================
# RAG System — Environment configuration
# Copy this file to .env and fill in AT LEAST ONE API key:
#   cp .env.example .env
#
#   - Only OPENAI_API_KEY     -> GPT-4o-mini + OpenAI embeddings
#   - Only ANTHROPIC_API_KEY  -> Claude + local embeddings (no key needed)
#   - Both                    -> choose with LLM_PROVIDER (default: openai)
#
# IN GITHUB ACTIONS these values are injected automatically:
#   🔒 Secrets  (sensitive values, never in logs):
#       OPENAI_API_KEY, ANTHROPIC_API_KEY, POSTGRES_PASSWORD
#   📦 Variables (non-sensitive configuration):
#       LLM_PROVIDER, OPENAI_CHAT_MODEL, OPENAI_EMBEDDING_MODEL,
#       ANTHROPIC_CHAT_MODEL, EMBEDDING_DIMENSION, TOP_K,
#       SIMILARITY_THRESHOLD
# =============================================================================

# --- API keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- LLM provider: "openai" | "anthropic" (empty = auto from the keys above) ---
LLM_PROVIDER=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# --- Embeddings: "openai" | "local" (empty = openai if its key is set, else local) ---
# Changing the provider/model triggers a re-index on the next container start.
EMBEDDING_PROVIDER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_DIMENSION=      # default: 1536 (openai) / 384 (local)
MAX_EMBED_CHARS=4000

# --- PostgreSQL + pgvector (docker compose overrides HOST/PORT for the app) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Retriever ---
TOP_K=5
SIMILARITY_THRESHOLD=0.2
RETRIEVAL_CANDIDATES=40

# --- Chat ---
CHAT_HISTORY_MESSAGES=6

# --- Web (running outside Docker) ---
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_DEBUG=false

# --- Host ports published by docker compose ---
APP_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
