{
  // Cloudflare Worker: static chat UI (public/) + RAG API. See README.md and doc/architecture.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rag-catalog",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "rag-catalog"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rag-catalog",
      // Paste the id printed by: npx wrangler d1 create rag-catalog
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  // 10 questions per minute per IP: protects the free daily AI quota
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // "workers-ai" (free) | "openai" | "anthropic" (need the matching secret)
    "LLM_PROVIDER": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "OPENAI_CHAT_MODEL": "gpt-4o-mini",
    "ANTHROPIC_CHAT_MODEL": "claude-haiku-4-5",
    "TOP_K": "5",
    "SIMILARITY_THRESHOLD": "0.35"
  },
  "observability": {
    "enabled": true
  }
}
