{
  "test_suite": "RAG System — Evaluation test suite",
  "version": "2.0",
  "notes": "Questions are in English; titles in expected_docs are kept as they appear in the (Spanish) catalog.",
  "tests": [
    {
      "id": "PEL-001",
      "category": "peliculas",
      "question": "Which science fiction movies with Tom Cruise do I have?",
      "expected_keywords": ["Al filo del mañana", "Tom Cruise", "science fiction"],
      "expected_docs": ["Al filo del mañana"],
      "min_docs": 1
    },
    {
      "id": "PEL-002",
      "category": "peliculas",
      "question": "Who directed 300 and what is it about?",
      "expected_keywords": ["Zack Snyder", "300", "Sparta", "Leonidas"],
      "expected_docs": ["300"],
      "min_docs": 1
    },
    {
      "id": "PEL-003",
      "category": "peliculas",
      "question": "What horror movies do I have?",
      "expected_keywords": ["horror"],
      "expected_docs": ["28 años después", "28 semanas después", "Alone"],
      "min_docs": 2
    },
    {
      "id": "PEL-004",
      "category": "peliculas",
      "question": "What rating does the movie Algunos hombres buenos have?",
      "expected_keywords": ["7.5", "Algunos hombres buenos", "Tom Cruise"],
      "expected_docs": ["Algunos hombres buenos"],
      "min_docs": 1
    },
    {
      "id": "LIB-001",
      "category": "libros",
      "question": "What survival books do I have?",
      "expected_keywords": ["survival"],
      "expected_docs": ["arboles comestibles", "como hacer fuego", "como hacer trampas"],
      "min_docs": 3
    },
    {
      "id": "LIB-002",
      "category": "libros",
      "question": "How do you make fire according to my books?",
      "expected_keywords": ["fire", "survival"],
      "expected_docs": ["como hacer fuego"],
      "min_docs": 1
    },
    {
      "id": "LIB-003",
      "category": "libros",
      "question": "Who wrote 'el horticultor autosuficiente'?",
      "expected_keywords": ["Seymour", "horticultor"],
      "expected_docs": ["el horticultor autosuficiente"],
      "min_docs": 1
    },
    {
      "id": "PEL-005",
      "category": "peliculas",
      "question": "Which movie is about stealing cars with Nicolas Cage?",
      "expected_keywords": ["60 segundos", "Nicolas Cage", "cars"],
      "expected_docs": ["60 segundos"],
      "min_docs": 1
    },
    {
      "id": "GEN-001",
      "category": null,
      "question": "What content do I have by Danny Boyle?",
      "expected_keywords": ["28 años después", "Danny Boyle"],
      "expected_docs": ["28 años después"],
      "min_docs": 1
    },
    {
      "id": "GEN-002",
      "category": null,
      "question": "What do I have about building an igloo?",
      "expected_keywords": ["igloo", "snow", "blocks"],
      "expected_docs": ["construye un iglu"],
      "min_docs": 1
    }
  ]
}
